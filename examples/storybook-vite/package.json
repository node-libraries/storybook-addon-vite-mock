{
  "name": "storybook-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "pnpm storybook:build && npm-run-all -p -r storybook:start storybook:test",
    "test:dev": "npm-run-all -p -r storybook:dev:ci storybook:test:dev",
    "storybook": "rimraf node_modules/.cache && storybook dev -p 9001",
    "storybook:dev:ci": "rimraf node_modules/.cache && storybook dev -p 9009 --ci --exact-port",
    "build-storybook": "storybook build",
    "storybook:build": "rimraf node_modules/.cache && storybook build",
    "storybook:start": "http-server -s -p 9001 storybook-static",
    "storybook:test": "wait-on -t 60000 tcp:127.0.0.1:9001 && test-storybook --url http://127.0.0.1:9001 --coverage",
    "storybook:test:dev": "wait-on -t 60000 tcp:127.0.0.1:9009 && test-storybook --url http://127.0.0.1:9009 --coverage",
    "lint": "eslint --fix ./stories",
    "lint:fix": "eslint --fix ./stories"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "1.97.0",
    "styled-jsx": "5.1.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "4.1.3",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-coverage": "3.0.2",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-onboarding": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@storybook/test-runner": "0.24.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "10.10.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "^16.5.0",
    "http-server": "14.1.1",
    "npm-run-all": "4.1.5",
    "playwright": "1.63.0",
    "rimraf": "6.1.2",
    "storybook": "10.6.0",
    "storybook-addon-vite-mock": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.0",
    "wait-on": "^9.1.0"
  },
  "main": "index.js",
  "repository": "https://github.com/node-libraries/storybook-addon-vite-mock",
  "author": "SoraKumo <info@croud.jp>",
  "license": "MIT"
}